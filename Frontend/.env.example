# Storage Configuration
# Use the same bucket names as your Backend

# Supabase Storage Configuration
EXPO_PUBLIC_SUPABASE_BUCKET=ed-iq-storage
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-anon-key

# Google Cloud Storage Configuration (if using GCS)
EXPO_PUBLIC_GCP_PROJECT_ID=your-project-id
EXPO_PUBLIC_GCP_BUCKET_NAME=your-gcp-bucket-name

# API Configuration
EXPO_PUBLIC_API_URL=http://localhost:8000
